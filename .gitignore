# Learn more https://docs.github.com/en/get-started/getting-started-with-git/ignoring-files

# ─── Dependencies ────────────────────────────────────────────────────────────
node_modules/

# ─── Expo ─────────────────────────────────────────────────────────────────────
.expo/
dist/
web-build/
expo-env.d.ts

# ─── Generated native folders (Expo managed workflow) ─────────────────────────
# Regenerated on every `npx expo run:android` / `npx expo run:ios`
/ios/
/android/

# ─── Metro bundler ────────────────────────────────────────────────────────────
.metro-health-check*

# ─── TypeScript ───────────────────────────────────────────────────────────────
*.tsbuildinfo

# ─── Native signing / certificates (NEVER commit these) ──────────────────────
.kotlin/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.pem
*.cer
*.der
*.crt

# ─── Environment & secrets ────────────────────────────────────────────────────
# .env.local, .env.production.local, etc. — contain real API keys
.env*.local
# Also ignore plain .env (in case someone creates one by mistake)
.env

# ─── Debug logs ───────────────────────────────────────────────────────────────
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# ─── OS artifacts ─────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ─── Editor / IDE ─────────────────────────────────────────────────────────────
# Keep .vscode/extensions.json & settings.json IF your team shares them.
# Ignore personal/machine-specific state only.
.vscode/.react/
.idea/
*.swp
*.swo

# ─── AI agent runtime state ───────────────────────────────────────────────────
# .superpowers/ contains agent session state — not project source
.superpowers/
# Git worktrees (project-local, never commit their contents)
.worktrees/
# .claude/ contains local Claude Code config (machine-specific)
.claude/
# .mcp.json contains local MCP server config (machine-specific)
.mcp.json
# .agents/ contains local skill configs — keep if you want to share with team,
# but ignore the cache/lock artefacts
skills-lock.json

# ─── Test artefacts ───────────────────────────────────────────────────────────
coverage/
.jest-cache/

# ─── Misc leftovers ───────────────────────────────────────────────────────────
app-example/
