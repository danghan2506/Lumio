@startuml
!theme plain
title Sequence Diagram — Email/Password Authentication and Initial Routing

autonumber
actor Learner
participant "Login / Register Form" as Form
participant "Supabase Auth Client" as AuthClient
participant "Supabase Auth" as Auth
participant "AsyncStorage" as Storage
participant "Root Layout
(Auth State Listener)" as Root
participant "Language Store
(Zustand)" as LanguageStore
participant "Expo Router" as Router

Learner -> Form: Submit email and password
Form -> Form: Validate required fields

alt Existing account
  Form -> AuthClient: signInWithPassword(email, password)
else New account
  Form -> AuthClient: signUp(email, password)
end

AuthClient -> Auth: Authenticate or create user
alt Authentication succeeds
  Auth --> AuthClient: Session and user data
  AuthClient -> Storage: Persist session
  Auth -> Root: Emit auth state change(session)
  Root -> LanguageStore: Read hasSelectedLanguage
  alt No active language selected
    Root -> Router: replace("/(auth)/select-language")
    Router --> Learner: Display language selection
  else Active language already selected
    Root -> Router: replace("/(tabs)")
    Router --> Learner: Display authenticated application
  end
else Authentication fails
  Auth --> AuthClient: Error message
  AuthClient --> Form: Authentication error
  Form --> Learner: Display user-friendly error
end
@enduml
